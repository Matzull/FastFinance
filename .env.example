# Copy this file to .env and fill with your own values.

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated Telegram user IDs allowed to use the bot (ask @userinfobot for yours)
TELEGRAM_ALLOWED_USER_IDS=123456789
OPENAI_API_KEY=your_openai_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Web server. Set a password before exposing it on your network (e.g. for the mobile app).
FASTFINANCE_HOST=127.0.0.1
FASTFINANCE_PORT=8000
FASTFINANCE_PASSWORD=
FASTFINANCE_RELOAD=false
